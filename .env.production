# Production environment - DO NOT COMMIT REAL SECRETS
# Replace all REPLACE_ME values via deployment tooling

VITE_API_URL=https://api.lumieremedical.com

# Database (Node/Drizzle)
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/medical_crm

# Python backend proxy target
LANGCHAIN_BACKEND_URL=http://python-api:8000

# Secrets - replace via deployment tooling (kubectl, sealed-secrets, etc.)
JWT_SECRET=REPLACE_ME_IN_PRODUCTION
DEEPSEEK_API_KEY=REPLACE_ME_IN_PRODUCTION
KIMI_API_KEY=REPLACE_ME_IN_PRODUCTION

# Services
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
