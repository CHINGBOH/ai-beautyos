# =============================================================================
# AI BeautyOS — Environment Variables
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env` to git.
# Categories:
#   [REQUIRED] — service refuses to start if missing
#   [RECOMMENDED] — sensible default, but set explicitly in production
#   [OPTIONAL] — only needed if you use the related integration
#   [DEV-ONLY] — must NOT be set in production
# Validation is enforced at startup by `server/_core/env-validation.ts`.
# =============================================================================


# -----------------------------------------------------------------------------
# [REQUIRED] Database — PostgreSQL (NOT MySQL)
# -----------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# In docker-compose the host is the service name (e.g. `postgres`).
# pgvector extension is required for the knowledge / RAG features and is
# enabled at install time by `pnpm db:pgvector` (script: scripts/enable-pgvector.ts).
# Use the official `pgvector/pgvector:pg16` image (or install the extension)
# so this script can succeed.
DATABASE_URL=postgresql://beautyos:beautyos@localhost:5432/beautyos


# -----------------------------------------------------------------------------
# [COMPOSE-ONLY] Postgres bootstrap credentials
# -----------------------------------------------------------------------------
# Used only by `docker-compose.yml` to initialize the database container on
# first run. In Compose, the `web` service derives DATABASE_URL automatically
# from these (host=postgres). Ignored when running outside of Compose.
POSTGRES_USER=beautyos
POSTGRES_PASSWORD=beautyos
POSTGRES_DB=beautyos
# Host port the web service is published on. Internal port stays 3000.
WEB_PORT=3000
# Tag for the locally built image (override in CI to e.g. the git sha).
IMAGE_TAG=local
# Stamped into the image and exposed at /healthz.commit — let CI override.
GIT_COMMIT=unknown


# -----------------------------------------------------------------------------
# [REQUIRED] Auth — JWT secret (>= 32 chars)
# -----------------------------------------------------------------------------
# Generate locally with:   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters-long


# -----------------------------------------------------------------------------
# [REQUIRED] AI — DeepSeek (chat / customer agent)
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_API_URL=https://api.deepseek.com/v1   # optional override


# -----------------------------------------------------------------------------
# [RECOMMENDED] Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000


# -----------------------------------------------------------------------------
# [OPTIONAL] AI — Qwen / OpenAI-compatible (analytics, embeddings, RAG)
# -----------------------------------------------------------------------------
# QWEN_API_KEY=your-qwen-api-key
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_EMBEDDING_MODEL=text-embedding-v3

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# EMBEDDING_PROVIDER=qwen        # qwen | openai
# EMBEDDING_MODEL=text-embedding-v3


# -----------------------------------------------------------------------------
# [OPTIONAL] Airtable (legacy import / sync; can also be configured in admin UI)
# -----------------------------------------------------------------------------
# Both vars are required together if used.
# AIRTABLE_API_TOKEN=patXXXXXXXXXXXXXX
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX


# -----------------------------------------------------------------------------
# [OPTIONAL] Manus / Forge platform integration (auto-injected when deployed
# on the Manus platform; leave empty for self-hosted Docker deployments)
# -----------------------------------------------------------------------------
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=


# -----------------------------------------------------------------------------
# [DEV-ONLY] — DO NOT set in production
# -----------------------------------------------------------------------------
# Setting DISABLE_AUTH=1 bypasses all authentication. Never use in production.
# DISABLE_AUTH=1


# -----------------------------------------------------------------------------
# WeChat Work (企业微信)
# -----------------------------------------------------------------------------
# All WeWork tenant credentials (corpId, secrets, agent IDs, encoding keys,
# tokens) are stored in the database and managed via the admin UI / tRPC
# routers — they are intentionally NOT environment variables.
# Bootstrap via:   pnpm wework:init


# -----------------------------------------------------------------------------
# Tenant Config — auto-approve low-risk drafts
# -----------------------------------------------------------------------------
# When "1", drafts proposed via POST /system/tenant-config/drafts with
# riskLevel="low" are auto-applied to the overlay file (status=approved,
# reviewedBy="system:auto-approve") instead of going to a human queue.
# Patches still go through schema validation; invalid patches return 422.
# medium/high drafts always require human approval. Off by default.
# BEAUTYOS_AUTO_APPROVE_LOW_RISK=0

# -----------------------------------------------------------------------------
# Standalone MCP Tool Server (Phase-3)
# -----------------------------------------------------------------------------
# The `tool-server` compose service runs the same image with a different
# entrypoint and listens on TOOL_SERVER_PORT (internal-network only).
# When set to "1", the Web/API process stops mounting /tools/* — clients
# must reach the standalone service instead (http://tool-server:5001/tools).
# Off by default so existing /tools/* callers on web keep working.
# BEAUTYOS_DISABLE_EMBEDDED_TOOL_SERVER=0
# TOOL_SERVER_PORT=5001
