# ========== 火山方舟（生文=豆包 doubao-seed-1-6-thinking，生图=Seedream doubao-seedream-5-0）==========
# 方式 A：方舟控制台创建 API Key + 推理接入点（生文），填下面两行；生图用默认 doubao-seedream-5-0
# VOLC_ARK_API_KEY=你的方舟APIKey
# VOLC_ARK_MODEL=ep-xxxxxxxx
# 方式 B：用 AK/SK，方舟控制台创建「生文」推理接入点得到 ep-xxx，填下面三行（生文/生图共用该 Key）
# VOLC_ACCESS_KEY_ID=你的AccessKeyId
# VOLC_SECRET_ACCESS_KEY=你的SecretAccessKey
# VOLC_ARK_MODEL=ep-xxxxxxxx
# 生图模型（可选，方舟默认 doubao-seedream-5-0）
# VOLC_ARK_IMAGE_MODEL=doubao-seedream-5-0
# 生图 API：ark=方舟 Seedream（需方舟 Key 或 接入点），visual=智能绘图 CVProcess（仅需 AK/SK）
# VOLC_IMAGE_API=ark
# VOLC_IMAGE_API=visual

# 方案 B：DeepSeek - 在 https://platform.deepseek.com 获取
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# 方案 C：Forge（由 Manus 等平台注入）
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# ========== 其他配置 ==========
# 数据库（职能助手/对话等依赖，使用 PostgreSQL）
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# 本地开发跳过登录（设为 1 时可直接使用，无需 OAuth。生产环境必须为 0）
DISABLE_AUTH=0

# Qwen API配置（数据分析可选）
QWEN_API_KEY=your-qwen-api-key-here
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# Airtable配置（可选，也可以通过管理后台配置）
# AIRTABLE_API_KEY=your-airtable-api-key
# AIRTABLE_BASE_ID=your-airtable-base-id

# 服务器配置
PORT=3000
NODE_ENV=development

# 落地页前端请求 API 的基址（Vite 构建时注入）
# 留空 = 与页面同源（推荐本地：只开 3000，由 Node 转发到 FastAPI）
# VITE_API_URL=
# 或直连 Python：VITE_API_URL=http://127.0.0.1:8000
# Node 转发目标（仅当 VITE 同源且走 Express 代理时有效，默认 8000）
# LANGCHAIN_BACKEND_URL=http://127.0.0.1:8000

# OAuth配置（由Manus平台自动注入）
# VITE_APP_ID=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=

